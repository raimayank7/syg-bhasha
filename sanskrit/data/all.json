[["नमस्ते।","namaste.","नमस्ते।","Hello. (I bow to you.)","/sanskrit/sentences/greetings/"],["सुप्रभातम्।","suprabhātam.","सुप्रभात।","Good morning.","/sanskrit/sentences/greetings/"],["शुभरात्रिः।","shubharātrih.","शुभ रात्रि।","Good night.","/sanskrit/sentences/greetings/"],["स्वागतम्।","svāgatam.","स्वागत है।","Welcome.","/sanskrit/sentences/greetings/"],["भवतः नाम किम्?","bhavatah nāma kim?","आपका नाम क्या है? (पुरुष से)","What is your name? (to a man)","/sanskrit/sentences/greetings/"],["भवत्याः नाम किम्?","bhavatyāh nāma kim?","आपका नाम क्या है? (महिला से)","What is your name? (to a woman)","/sanskrit/sentences/greetings/"],["मम नाम अमनः।","mama nāma amanah.","मेरा नाम अमन है।","My name is Aman.","/sanskrit/sentences/greetings/"],["भवान् कथम् अस्ति?","bhavān katham asti?","आप कैसे हैं? (पुरुष से)","How are you? (to a man)","/sanskrit/sentences/greetings/"],["भवती कथम् अस्ति?","bhavatī katham asti?","आप कैसी हैं? (महिला से)","How are you? (to a woman)","/sanskrit/sentences/greetings/"],["अहं कुशली अस्मि।","aham kushalī asmi.","मैं कुशल हूँ। (पुरुष)","I am well. (said by a man)","/sanskrit/sentences/greetings/"],["अहं कुशलिनी अस्मि।","aham kushalinī asmi.","मैं कुशल हूँ। (महिला)","I am well. (said by a woman)","/sanskrit/sentences/greetings/"],["भवान् कुत्र वसति?","bhavān kutra vasati?","आप कहाँ रहते हैं?","Where do you live?","/sanskrit/sentences/greetings/"],["अहं लुधियानानगरे वसामि।","aham ludhiyānānagare vasāmi.","मैं लुधियाना नगर में रहता हूँ।","I live in the city of Ludhiana.","/sanskrit/sentences/greetings/"],["भवान् किं करोति?","bhavān kim karoti?","आप क्या करते हैं?","What do you do?","/sanskrit/sentences/greetings/"],["अहं छात्रः अस्मि।","aham chhātrah asmi.","मैं छात्र हूँ।","I am a student. (male)","/sanskrit/sentences/greetings/"],["अहं छात्रा अस्मि।","aham chhātrā asmi.","मैं छात्रा हूँ।","I am a student. (female)","/sanskrit/sentences/greetings/"],["अहं संस्कृतं पठामि।","aham samskritam pathāmi.","मैं संस्कृत पढ़ता हूँ।","I study Sanskrit.","/sanskrit/sentences/greetings/"],["धन्यवादः।","dhanyavādah.","धन्यवाद।","Thank you.","/sanskrit/sentences/greetings/"],["पुनः मिलामः।","punah milāmah.","फिर मिलेंगे।","We shall meet again.","/sanskrit/sentences/greetings/"],["शुभं भवतु।","shubham bhavatu.","आपका शुभ हो।","May it be well with you.","/sanskrit/sentences/greetings/"],["अहं प्रातःकाले उत्तिष्ठामि।","aham prātahkāle uttishthāmi.","मैं सुबह उठता हूँ।","I get up in the morning.","/sanskrit/sentences/daily-life/"],["अहं दन्तधावनं करोमि।","aham dantadhāvanam karomi.","मैं दाँत साफ़ करता हूँ।","I brush my teeth.","/sanskrit/sentences/daily-life/"],["अहं स्नानं करोमि।","aham snānam karomi.","मैं स्नान करता हूँ।","I take a bath.","/sanskrit/sentences/daily-life/"],["अहम् ईश्वरं नमामि।","aham īshvaram namāmi.","मैं ईश्वर को प्रणाम करता हूँ।","I bow to God.","/sanskrit/sentences/daily-life/"],["अहं दुग्धं पिबामि।","aham dugdham pibāmi.","मैं दूध पीता हूँ।","I drink milk.","/sanskrit/sentences/daily-life/"],["अहं रोटिकां खादामि।","aham rotikām khādāmi.","मैं रोटी खाता हूँ।","I eat roti.","/sanskrit/sentences/daily-life/"],["अहं विद्यालयं गच्छामि।","aham vidyālayam gachchhāmi.","मैं विद्यालय जाता हूँ।","I go to school.","/sanskrit/sentences/daily-life/"],["अहं पुस्तकं पठामि।","aham pustakam pathāmi.","मैं पुस्तक पढ़ता हूँ।","I read a book.","/sanskrit/sentences/daily-life/"],["अहं लेखं लिखामि।","aham lekham likhāmi.","मैं लेख लिखता हूँ।","I write an essay.","/sanskrit/sentences/daily-life/"],["वयं मिलित्वा क्रीडामः।","vayam militvā krīdāmah.","हम मिलकर खेलते हैं।","We play together.","/sanskrit/sentences/daily-life/"],["अहं गृहम् आगच्छामि।","aham griham āgachchhāmi.","मैं घर आता हूँ।","I come home.","/sanskrit/sentences/daily-life/"],["माता भोजनं पचति।","mātā bhojanam pachati.","माँ भोजन पकाती है।","Mother cooks the food.","/sanskrit/sentences/daily-life/"],["पिता कार्यालयं गच्छति।","pitā kāryālayam gachchhati.","पिता कार्यालय जाते हैं।","Father goes to the office.","/sanskrit/sentences/daily-life/"],["अहं मातरं पितरं च वन्दे।","aham mātaram pitaram cha vande.","मैं माता और पिता को प्रणाम करता हूँ।","I salute my mother and father.","/sanskrit/sentences/daily-life/"],["मम गृहे चत्वारः जनाः सन्ति।","mama grihe chatvārah janāh santi.","मेरे घर में चार लोग हैं।","There are four people in my home.","/sanskrit/sentences/daily-life/"],["अद्य अवकाशः अस्ति।","adya avakāshah asti.","आज छुट्टी है।","Today is a holiday.","/sanskrit/sentences/daily-life/"],["अहं रात्रौ शयनं करोमि।","aham rātrau shayanam karomi.","मैं रात को सोता हूँ।","I sleep at night.","/sanskrit/sentences/daily-life/"],["जलं ददातु।","jalam dadātu.","पानी दीजिए।","Please give me water.","/sanskrit/sentences/daily-life/"],["भोजनं स्वादु अस्ति।","bhojanam svādu asti.","भोजन स्वादिष्ट है।","The food is tasty.","/sanskrit/sentences/daily-life/"],["अहं संस्कृतं जानामि।","aham samskritam jānāmi.","मैं संस्कृत जानता हूँ।","I know Sanskrit.","/sanskrit/sentences/daily-life/"],["आगच्छतु।","āgachchhatu.","आइए।","Please come.","/sanskrit/sentences/classroom/"],["उपविशतु।","upavishatu.","बैठिए।","Please sit down.","/sanskrit/sentences/classroom/"],["उत्तिष्ठतु।","uttishthatu.","खड़े होइए।","Please stand up.","/sanskrit/sentences/classroom/"],["कृपया पुनः वदतु।","kripayā punah vadatu.","कृपया फिर से बोलिए।","Please say it again.","/sanskrit/sentences/classroom/"],["शनैः वदतु।","shanaih vadatu.","धीरे बोलिए।","Please speak slowly.","/sanskrit/sentences/classroom/"],["पुस्तकम् उद्घाटयतु।","pustakam udghātayatu.","पुस्तक खोलिए।","Please open the book.","/sanskrit/sentences/classroom/"],["पठतु।","pathatu.","पढ़िए।","Please read.","/sanskrit/sentences/classroom/"],["लिखतु।","likhatu.","लिखिए।","Please write.","/sanskrit/sentences/classroom/"],["अहं न जानामि।","aham na jānāmi.","मुझे नहीं पता।","I do not know.","/sanskrit/sentences/classroom/"],["अहं न अवगच्छामि।","aham na avagachchhāmi.","मुझे समझ नहीं आया।","I do not understand.","/sanskrit/sentences/classroom/"],["एकः प्रश्नः अस्ति।","ekah prashnah asti.","एक प्रश्न है।","I have a question.